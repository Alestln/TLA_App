------------------------- MODULE Ex4_Counter_Fixed -------------------------
(***************************************************************************)
(* Пример 4 (Исправленный вариант). Атомарный инкремент (Interlocked).      *)
(* Инкремент выполняется как единая неделимая операция:                    *)
(*   counter' = counter + 1                                                *)
(* Никакой поток не может вклиниться между чтением и записью!              *)
(***************************************************************************)
EXTENDS Integers

VARIABLES 
    counter,    \* Общий счётчик в памяти
    t1_done,    \* Флаг завершения потока 1 (TRUE / FALSE)
    t2_done     \* Флаг завершения потока 2 (TRUE / FALSE)

vars == <<counter, t1_done, t2_done>>

Init ==
    /\ counter = 0
    /\ t1_done = FALSE
    /\ t2_done = FALSE

\* Поток 1: атомарный инкремент (Interlocked.Increment)
T1_Inc ==
    /\ ~t1_done
    /\ counter' = counter + 1
    /\ t1_done' = TRUE
    /\ UNCHANGED t2_done

\* Поток 2: атомарный инкремент (Interlocked.Increment)
T2_Inc ==
    /\ ~t2_done
    /\ counter' = counter + 1
    /\ t2_done' = TRUE
    /\ UNCHANGED t1_done

\* Завершение работы обоих потоков
Done ==
    /\ t1_done
    /\ t2_done
    /\ UNCHANGED vars

Next ==
    \/ T1_Inc
    \/ T2_Inc
    \/ Done

-----------------------------------------------------------------------------
\* ИНВАРИАНТ:
\* Если оба потока завершили работу, итоговое значение счётчика ОБЯЗАНО быть 2!
CorrectSum ==
    (t1_done /\ t2_done) => (counter = 2)

=============================================================================
