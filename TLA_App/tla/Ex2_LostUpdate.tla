-------------------------- MODULE Ex2_LostUpdate --------------------------
(***************************************************************************)
(* Пример 2. Два потока выполняют x++ (как _counter++ в C#).               *)
(* На уровне процессора x++ — это ДВА шага:                                *)
(*     1) tmp = x        (чтение)                                          *)
(*     2) x   = tmp + 1  (запись)                                          *)
(* Цель: увидеть недетерминизм, массивы-функции, EXCEPT, UNCHANGED.        *)
(***************************************************************************)
EXTENDS Naturals, FiniteSets

CONSTANT Threads            \* множество потоков; значение задаётся в .cfg

VARIABLES
    x,                      \* общая переменная (поле класса в C#)
    tmp,                    \* локальная копия x у каждого потока (регистр CPU)
    pc                      \* "program counter": на какой строке стоит поток

vars == <<x, tmp, pc>>      \* кортеж всех переменных (нужен для UNCHANGED)

Init ==
    /\ x   = 0
    /\ tmp = [t \in Threads |-> 0]          \* у каждого потока tmp = 0
    /\ pc  = [t \in Threads |-> "read"]     \* все потоки стоят на чтении

\* Шаг 1 потока t: прочитать x в свой регистр
Read(t) ==
    /\ pc[t] = "read"                                \* охранное условие
    /\ tmp' = [tmp EXCEPT ![t] = x]                  \* tmp[t] := x
    /\ pc'  = [pc  EXCEPT ![t] = "write"]            \* перейти к записи
    /\ UNCHANGED x                                   \* x не меняется

\* Шаг 2 потока t: записать tmp + 1 обратно в x
Write(t) ==
    /\ pc[t] = "write"
    /\ x'  = tmp[t] + 1
    /\ pc' = [pc EXCEPT ![t] = "done"]
    /\ UNCHANGED tmp

\* Все закончили: разрешаем "стоять на месте", чтобы TLC не считал это deadlock
Finished ==
    /\ \A t \in Threads : pc[t] = "done"
    /\ UNCHANGED vars

\* Любой поток может сделать любой разрешённый шаг — это и есть планировщик ОС
Next == (\E t \in Threads : Read(t) \/ Write(t)) \/ Finished

\* Свойство корректности: когда все потоки закончили, x = число потоков
NoLostUpdate ==
    (\A t \in Threads : pc[t] = "done") => x = Cardinality(Threads)

=============================================================================
