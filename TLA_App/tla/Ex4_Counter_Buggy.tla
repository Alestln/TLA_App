------------------------- MODULE Ex4_Counter_Buggy -------------------------
(***************************************************************************)
(* Пример 4 (Ошибочный вариант). Неатомарный инкремент (Lost Update).      *)
(* counter = counter + 1 на самом деле состоит из 2 шагов:                 *)
(*   1) Чтение в локальный регистр: reg = counter                         *)
(*   2) Запись обратно: counter = reg + 1                                  *)
(* Если два потока прочитают 0 одновременно, один инкремент потеряется!     *)
(***************************************************************************)
EXTENDS Integers

VARIABLES 
    counter,    \* Общий счётчик в памяти
    t1_pc,      \* Состояние потока 1: "idle", "read", "done"
    t1_reg,     \* Локальный регистр потока 1
    t2_pc,      \* Состояние потока 2: "idle", "read", "done"
    t2_reg      \* Локальный регистр потока 2

vars == <<counter, t1_pc, t1_reg, t2_pc, t2_reg>>

Init ==
    /\ counter = 0
    /\ t1_pc = "idle"
    /\ t1_reg = 0
    /\ t2_pc = "idle"
    /\ t2_reg = 0

\* Поток 1: считывает counter в свой регистр
T1_Read ==
    /\ t1_pc = "idle"
    /\ t1_reg' = counter
    /\ t1_pc' = "read"
    /\ UNCHANGED <<counter, t2_pc, t2_reg>>

\* Поток 1: вычисляет reg + 1 и записывает в память
T1_Write ==
    /\ t1_pc = "read"
    /\ counter' = t1_reg + 1
    /\ t1_pc' = "done"
    /\ UNCHANGED <<t1_reg, t2_pc, t2_reg>>

\* Поток 2: считывает counter в свой регистр
T2_Read ==
    /\ t2_pc = "idle"
    /\ t2_reg' = counter
    /\ t2_pc' = "read"
    /\ UNCHANGED <<counter, t1_pc, t1_reg>>

\* Поток 2: вычисляет reg + 1 и записывает в память
T2_Write ==
    /\ t2_pc = "read"
    /\ counter' = t2_reg + 1
    /\ t2_pc' = "done"
    /\ UNCHANGED <<t2_reg, t1_pc, t1_reg>>

\* Завершение работы обоих потоков
Done ==
    /\ t1_pc = "done"
    /\ t2_pc = "done"
    /\ UNCHANGED vars

Next ==
    \/ T1_Read
    \/ T1_Write
    \/ T2_Read
    \/ T2_Write
    \/ Done

-----------------------------------------------------------------------------
\* ИНВАРИАНТ:
\* Если оба потока завершили работу, итоговое значение счётчика ОБЯЗАНО быть 2!
CorrectSum ==
    (t1_pc = "done" /\ t2_pc = "done") => (counter = 2)

=============================================================================
